{
    "configurations": [
        {
            "name": "debug sim lwfa",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/cpp/bench/sim_lwfa",
            "args": ["250", "10", "10", "lwfa"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                },
                {
                    "description": "Clear debuginfod URLs",
                    "text": "set debuginfod urls ",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "bench sim lwfa",
            "miDebuggerPath": "/usr/bin/gdb"
        },
