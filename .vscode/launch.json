{
    "configurations": [
        {
            "name": "C/C++: g++ build and debug active file",
            "type": "cppdbg",
            "request": "launch",
            "program": "${fileDirname}/${fileBasenameNoExtension}",
            "args": ["${workspaceFolder}/test/data/local/200_0.05_10.csv", "${input:lib}", "${input:method}"],
            "stopAtEntry": false,
            "cwd": "${fileDirname}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                },
                {
                    "description": "Clear debuginfod URLs",
                    "text": "set debuginfod urls ",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "C/C++: g++ build active file",
            "miDebuggerPath": "/usr/bin/gdb"
        },
    ],
    "inputs": [
        {
            "id": "lib",
            "type": "pickString",
            "description": "Select library:",
            "options": [
                "lwfa",
                "lbiwfa",
                "parasail",
                "seqan",
            ],
            "default": "lwfa"
        },
        {
            "id": "method",
            "type": "pickString",
            "description": "Select parasail method:",
            "options": [
                "striped",
                "scan",
                "diag"
            ],
            "default": "striped"
        }
    ],
    "version": "2.0.0"
}