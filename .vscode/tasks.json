{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "bench sim lwfa",
            "command": "/usr/bin/g++",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "-std=gnu++23",
                "bench/sim_lwfa.cpp",
                "-o",
                "bench/sim_lwfa"
            ],
            "options": {
                "cwd": "${workspaceFolder}/cpp"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build",
            "detail": "Build sim lwfa."
        },
